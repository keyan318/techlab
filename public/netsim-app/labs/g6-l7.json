  "lab": {
    "id": "g6-l7",
    "title": "Lesson 6.7 — DNS Security",
    "blurb": "Doom's fake update domain, a sinkhole, and no way around it.",
    "steps": [
      {
        "title": "Sinkhole the fake domain",
        "body": "From astro, `nslookup codexia-update.net` answers 198.51.100.66: Doom. Double-click `grid-dns` (Windows Server). `Get-DnsServerResourceRecord` lists its records. Replace the bad one: `Remove-DnsServerResourceRecord -ZoneName codexia-update.net -Name @ -RRType A -Force`, then `Add-DnsServerResourceRecordA -ZoneName codexia-update.net -Name @ -IPv4Address 192.168.100.66`. From astro: `curl http://codexia-update.net/`.",
        "objectives": [
          {
            "id": "g6l7-dns",
            "label": "codexia-update.net now resolves to the sinkhole for astro",
            "check": {
              "type": "dns",
              "from": "astro",
              "name": "codexia-update.net",
              "expect": "resolves",
              "addr": "192.168.100.66"
            }
          },
          {
            "id": "g6l7-page",
            "label": "astro gets the warning page instead of Doom's",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://codexia-update.net/",
              "expect": "ok",
              "contains": "Blocked by the Grid"
            }
          }
        ]
      },
      {
        "title": "No asking anyone else",
        "body": "rogue-pc ignores the Grid resolver and asks Earth's public one, which still gives Doom's address. On `gate`: `ip access-list extended GRID-DNS`, then `permit udp host 192.168.100.53 any eq domain`, `deny udp any any eq domain`, `deny tcp any any eq 853`, `permit ip any any`, `exit`. Apply it where the terminals' traffic enters: `interface g0/0`, `ip access-group GRID-DNS in`.",
        "objectives": [
          {
            "id": "g6l7-acl",
            "label": "GRID-DNS is applied inbound on gate Gi0/0",
            "check": {
              "type": "iface-config",
              "device": "gate",
              "iface": "eth0",
              "is": {
                "aclIn": "GRID-DNS"
              }
            }
          },
          {
            "id": "g6l7-rogue",
            "label": "rogue-pc can no longer use Earth's resolver",
            "check": {
              "type": "dns",
              "from": "rogue-pc",
              "name": "codexia-update.net",
              "expect": "blocked"
            }
          },
          {
            "id": "g6l7-dot",
            "label": "DNS over TLS (853) to outside resolvers is blocked",
            "check": {
              "type": "tcp",
              "from": "rogue-pc",
              "toDevice": "earth-dns",
              "port": 853,
              "expect": "filtered"
            }
          },
          {
            "id": "g6l7-web",
            "label": "astro still reaches Earth's web page",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://198.51.100.10/",
              "expect": "ok",
              "contains": "Earth relay"
            }
          }
        ]
      },
      {
        "title": "Close the DoH door",
        "body": "DNS over HTTPS hides in ordinary port 443 traffic, so block it to the known public resolver only. Rules are checked in order and `permit ip any any` comes last, so insert before it: `ip access-list extended GRID-DNS`, then `35 deny tcp any host 198.51.100.53 eq 443`. `show access-lists` shows it in place.",
        "objectives": [
          {
            "id": "g6l7-doh",
            "label": "DoH (443) to Earth's resolver is blocked",
            "check": {
              "type": "tcp",
              "from": "rogue-pc",
              "toDevice": "earth-dns",
              "port": 443,
              "expect": "filtered"
            }
          },
          {
            "id": "g6l7-acl2",
            "label": "GRID-DNS denies HTTPS to 198.51.100.53",
            "check": {
              "type": "acl",
              "device": "gate",
              "name": "GRID-DNS",
              "has": "deny tcp any host 198.51.100.53 eq 443"
            }
          },
          {
            "id": "g6l7-web2",
            "label": "astro still reaches Earth's web page",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://198.51.100.10/",
              "expect": "ok",
              "contains": "Earth relay"
            }
          }
        ]
      }
    ]
