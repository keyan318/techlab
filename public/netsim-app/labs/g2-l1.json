{
  "app": "netsim",
  "version": 1,
  "devices": [
    {
      "id": "astro",
      "kind": "host",
      "name": "astro",
      "x": 20,
      "y": 60,
      "forwarding": false,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "192.168.10.10/24",
          "up": true
        }
      ],
      "routes": [
        {
          "dest": "0.0.0.0/0",
          "via": "192.168.10.1",
          "dev": "eth0"
        }
      ]
    },
    {
      "id": "landing",
      "kind": "router",
      "name": "landing",
      "x": 200,
      "y": 60,
      "forwarding": true,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "192.168.10.1/24",
          "up": true
        },
        {
          "name": "eth1",
          "ip": "10.0.12.1/30",
          "up": true
        },
        {
          "name": "eth2",
          "ip": null,
          "up": false
        },
        {
          "name": "eth3",
          "ip": null,
          "up": false
        }
      ],
      "routes": [],
      "cli": "ios",
      "hostname": "LANDING"
    },
    {
      "id": "citadel",
      "kind": "router",
      "name": "citadel",
      "x": 400,
      "y": 60,
      "forwarding": true,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "10.0.12.2/30",
          "up": true
        },
        {
          "name": "eth1",
          "ip": "10.0.23.1/30",
          "up": true
        },
        {
          "name": "eth2",
          "ip": "192.168.20.1/24",
          "up": true
        },
        {
          "name": "eth3",
          "ip": null,
          "up": false
        }
      ],
      "routes": [],
      "cli": "ios",
      "hostname": "CITADEL"
    },
    {
      "id": "citadel-srv",
      "kind": "server",
      "name": "citadel-srv",
      "x": 400,
      "y": 260,
      "forwarding": false,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "192.168.20.10/24",
          "up": true
        }
      ],
      "routes": [
        {
          "dest": "0.0.0.0/0",
          "via": "192.168.20.1",
          "dev": "eth0"
        }
      ],
      "httpServer": {
        "enabled": true,
        "port": 80,
        "body": "Citadel archive online. Routed by OSPF."
      }
    },
    {
      "id": "northwatch",
      "kind": "router",
      "name": "northwatch",
      "x": 600,
      "y": 60,
      "forwarding": true,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "10.0.23.2/30",
          "up": true
        },
        {
          "name": "eth1",
          "ip": "192.168.30.1/24",
          "up": true
        },
        {
          "name": "eth2",
          "ip": null,
          "up": false
        },
        {
          "name": "eth3",
          "ip": null,
          "up": false
        }
      ],
      "routes": [],
      "cli": "ios",
      "hostname": "NORTHWATCH"
    },
    {
      "id": "volt",
      "kind": "host",
      "name": "volt",
      "x": 600,
      "y": 260,
      "forwarding": false,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "192.168.30.10/24",
          "up": true
        }
      ],
      "routes": [
        {
          "dest": "0.0.0.0/0",
          "via": "192.168.30.1",
          "dev": "eth0"
        }
      ]
    }
  ],
  "links": [
    {
      "id": "astro.eth0-landing.eth0",
      "a": [
        "astro",
        "eth0"
      ],
      "b": [
        "landing",
        "eth0"
      ]
    },
    {
      "id": "landing.eth1-citadel.eth0",
      "a": [
        "landing",
        "eth1"
      ],
      "b": [
        "citadel",
        "eth0"
      ]
    },
    {
      "id": "citadel.eth2-citadel-srv.eth0",
      "a": [
        "citadel",
        "eth2"
      ],
      "b": [
        "citadel-srv",
        "eth0"
      ]
    },
    {
      "id": "citadel.eth1-northwatch.eth0",
      "a": [
        "citadel",
        "eth1"
      ],
      "b": [
        "northwatch",
        "eth0"
      ]
    },
    {
      "id": "northwatch.eth1-volt.eth0",
      "a": [
        "northwatch",
        "eth1"
      ],
      "b": [
        "volt",
        "eth0"
      ]
    }
  ],
  "lab": {
    "id": "g2-l1",
    "title": "Lesson 2.1 — Link-State Routing with OSPF",
    "blurb": "Three outposts, no routes. Teach the routers to share what they know.",
    "steps": [
      {
        "title": "First neighbors",
        "body": "On `landing`: `enable`, `conf t`, `router ospf 1`, then one `network` line per interface: `network 192.168.10.0 0.0.0.255 area 0` and `network 10.0.12.0 0.0.0.3 area 0`. On `citadel`, do the same for its three networks: 10.0.12.0/30, 10.0.23.0/30 and 192.168.20.0/24. Check with `show ip ospf neighbor` and `show ip route`.",
        "objectives": [
          {
            "id": "g2l1-n1",
            "label": "landing and citadel are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "landing",
              "neighbor": "citadel",
              "expect": "full"
            }
          },
          {
            "id": "g2l1-r1",
            "label": "landing learned 192.168.20.0/24 from OSPF",
            "check": {
              "type": "route",
              "device": "landing",
              "dest": "192.168.20.0/24",
              "source": "ospf",
              "expect": "present"
            }
          },
          {
            "id": "g2l1-h1",
            "label": "astro opens http://192.168.20.10/ (the Citadel archive)",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://192.168.20.10/",
              "expect": "ok",
              "contains": "Citadel archive"
            }
          }
        ]
      },
      {
        "title": "Bring Northwatch in",
        "body": "On `northwatch`: `router ospf 1` with `network 10.0.23.0 0.0.0.3 area 0` and `network 192.168.30.0 0.0.0.255 area 0`. Nobody touches landing: it learns the new network from the Citadel.",
        "objectives": [
          {
            "id": "g2l1-n2",
            "label": "citadel and northwatch are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "citadel",
              "neighbor": "northwatch",
              "expect": "full"
            }
          },
          {
            "id": "g2l1-r2",
            "label": "landing learned 192.168.30.0/24 from OSPF",
            "check": {
              "type": "route",
              "device": "landing",
              "dest": "192.168.30.0/24",
              "source": "ospf",
              "expect": "present"
            }
          },
          {
            "id": "g2l1-p2",
            "label": "astro reaches volt at Northwatch",
            "check": {
              "type": "ping",
              "from": "astro",
              "expect": "success",
              "toDevice": "volt"
            }
          }
        ]
      },
      {
        "title": "Keep hellos off the PC networks",
        "body": "Volt: \"Never send router hellos where only PCs live.\" In `router ospf 1` on each router, make the LAN port passive: `passive-interface g0/0` on landing, `passive-interface g0/2` on citadel, `passive-interface g0/1` on northwatch. `show ip protocols` lists them.",
        "objectives": [
          {
            "id": "g2l1-pa1",
            "label": "landing Gi0/0 is passive",
            "check": {
              "type": "iface-config",
              "device": "landing",
              "iface": "eth0",
              "is": {
                "ospfPassive": true
              }
            }
          },
          {
            "id": "g2l1-pa2",
            "label": "citadel Gi0/2 is passive",
            "check": {
              "type": "iface-config",
              "device": "citadel",
              "iface": "eth2",
              "is": {
                "ospfPassive": true
              }
            }
          },
          {
            "id": "g2l1-pa3",
            "label": "northwatch Gi0/1 is passive",
            "check": {
              "type": "iface-config",
              "device": "northwatch",
              "iface": "eth1",
              "is": {
                "ospfPassive": true
              }
            }
          },
          {
            "id": "g2l1-p3",
            "label": "astro still reaches volt",
            "check": {
              "type": "ping",
              "from": "astro",
              "expect": "success",
              "toDevice": "volt"
            }
          }
        ]
      }
    ]
  }
}
