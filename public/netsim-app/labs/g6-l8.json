  "lab": {
    "id": "g6-l8",
    "title": "Lesson 6.8 — Final Mission: Hold the Grid",
    "blurb": "The raid. Four layers, four faults, one Grid to hold.",
    "steps": [
      {
        "title": "Switching: stop the takeover",
        "body": "On `hangar-sw`, `show spanning-tree`: the root bridge isn't ours. A switch on Gi0/6 claims priority 0. Protect every user port: `interface range g0/1 - 6`, `spanning-tree portfast`, `spanning-tree bpduguard enable`.",
        "objectives": [
          {
            "id": "g6l8-bg",
            "label": "hangar-sw Gi0/1 has PortFast and BPDU Guard",
            "check": {
              "type": "iface-config",
              "device": "hangar-sw",
              "iface": "eth0",
              "is": {
                "portfast": true,
                "bpduguard": true
              }
            }
          },
          {
            "id": "g6l8-err",
            "label": "The rogue switch's port (Gi0/6) is err-disabled",
            "check": {
              "type": "stp-port",
              "device": "hangar-sw",
              "iface": "eth5",
              "vlan": 1,
              "state": "err-disabled"
            }
          },
          {
            "id": "g6l8-root",
            "label": "hangar-sw is the root bridge again",
            "check": {
              "type": "stp-root",
              "vlan": 1,
              "device": "hangar-sw"
            }
          }
        ]
      },
      {
        "title": "Routing: find the missing neighbor",
        "body": "On `citadel`, `show ip ospf neighbor` lists only sky-a. On `sky-b`, `show ip protocols`: someone made its uplink passive. In `router ospf 1`: `no passive-interface g0/0`.",
        "objectives": [
          {
            "id": "g6l8-nb",
            "label": "citadel and sky-b are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "citadel",
              "neighbor": "sky-b",
              "expect": "full"
            }
          },
          {
            "id": "g6l8-two",
            "label": "citadel has two paths to the hangar",
            "check": {
              "type": "route",
              "device": "citadel",
              "dest": "192.168.50.0/24",
              "source": "ospf",
              "expect": "present",
              "paths": 2
            }
          }
        ]
      },
      {
        "title": "Gateways: fail over for real",
        "body": "sky-a is the hangar's active gateway. If its uplink dies, it stays active and drops everything. On `sky-a` g0/1: `standby 50 track g0/0 20`. On `sky-b` g0/1: `standby 50 preempt`. The grader cuts sky-a's uplink and LAN port for a moment each.",
        "objectives": [
          {
            "id": "g6l8-trk",
            "label": "sky-a tracks its uplink",
            "check": {
              "type": "iface-config",
              "device": "sky-a",
              "iface": "eth1",
              "is": {
                "fhrpTrack": "eth0"
              }
            }
          },
          {
            "id": "g6l8-s1",
            "label": "rivet still reaches Earth if sky-a loses its uplink",
            "check": {
              "type": "survives",
              "from": "rivet",
              "toDevice": "earth-srv",
              "cut": {
                "device": "sky-a",
                "iface": "eth0"
              }
            }
          },
          {
            "id": "g6l8-s2",
            "label": "rivet still reaches Earth if sky-a's hangar port fails",
            "check": {
              "type": "survives",
              "from": "rivet",
              "toDevice": "earth-srv",
              "cut": {
                "device": "sky-a",
                "iface": "eth1"
              }
            }
          }
        ]
      },
      {
        "title": "Edge: lock Vex out",
        "body": "Vex (203.0.113.66) is hammering SSH on the crew server. On `citadel`: `ip access-list extended EDGE-IN`, `deny ip host 203.0.113.66 any`, `permit ip any any`, `exit`, then `interface g0/3`, `ip access-group EDGE-IN in`. Last test: from rivet, `curl http://203.0.113.10/`.",
        "objectives": [
          {
            "id": "g6l8-acl",
            "label": "EDGE-IN is applied inbound on citadel Gi0/3",
            "check": {
              "type": "iface-config",
              "device": "citadel",
              "iface": "eth3",
              "is": {
                "aclIn": "EDGE-IN"
              }
            }
          },
          {
            "id": "g6l8-vex",
            "label": "Vex can no longer reach SSH on the crew server",
            "check": {
              "type": "tcp",
              "from": "vex",
              "toDevice": "crew-srv",
              "port": 22,
              "expect": "filtered"
            }
          },
          {
            "id": "g6l8-earth",
            "label": "Earth still opens the Citadel crew page",
            "check": {
              "type": "http",
              "from": "earth-srv",
              "url": "http://192.168.20.22/",
              "expect": "ok",
              "contains": "the Grid holds"
            }
          },
          {
            "id": "g6l8-final",
            "label": "rivet opens Earth's page from Skyport",
            "check": {
              "type": "http",
              "from": "rivet",
              "url": "http://203.0.113.10/",
              "expect": "ok",
              "contains": "docking at Skyport"
            }
          }
        ]
      }
    ]
  }
