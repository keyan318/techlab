        "eth0"
      ],
      "b": [
        "relay",
        "eth4"
      ]
    },
    {
      "id": "gate.eth1-earth-cloud.eth0",
      "a": [
        "gate",
        "eth1"
      ],
      "b": [
        "earth-cloud",
        "eth0"
      ]
    }
  ],
  "lab": {
    "id": "m4-l6",
    "title": "Lesson 4.6 — Final Mission: Call Earth",
    "blurb": "Six faults across four layers stand between the crew and home.",
    "steps": [
      {
        "title": "1. Physical: the bottom of the stack",
        "body": "Start at Layer 1. Something on the comms deck has no link. Use `netsh interface show interface` on the devices and ping from `ship-server` to find it, and bring it up.",
        "objectives": [
          {
            "id": "m4l6-rivet",
            "label": "ship-server can reach rivet",
            "check": {
              "type": "ping",
              "from": "ship-server",
              "expect": "success",
              "toDevice": "rivet"
            }
          }
        ]
      },
      {
        "title": "2. Addressing: DHCP for the crew",
        "body": "Astro and volt use DHCP. Run `ipconfig /renew` on both and see who is left out. Then look at everything the crew needs from a lease: an address, a way out (router) and a name server (dns). Fix the DHCP server in the Inspector, then renew both consoles with `ipconfig /renew`. The router is `192.168.20.1` and the name server is `192.168.20.2`.",
        "objectives": [
          {
            "id": "m4l6-astro",
            "label": "astro has an address in 192.168.20.0/24",
            "check": {
              "type": "iface-ip",
              "device": "astro",
              "iface": "eth0",
              "inSubnet": "192.168.20.0/24"
            }
          },
          {
            "id": "m4l6-volt",
            "label": "volt has an address in 192.168.20.0/24",
            "check": {
              "type": "iface-ip",
              "device": "volt",
              "iface": "eth0",
              "inSubnet": "192.168.20.0/24"
            }
          },
          {
            "id": "m4l6-gw-a",
            "label": "astro's default route goes via 192.168.20.1",
            "check": {
              "type": "default-route",
              "device": "astro",
              "via": "192.168.20.1"
            }
          },
          {
            "id": "m4l6-gw-v",
            "label": "volt's default route goes via 192.168.20.1",
            "check": {
              "type": "default-route",
              "device": "volt",
              "via": "192.168.20.1"
            }
          }
        ]
      },
      {
        "title": "3. Routing: reach Earth by number",
        "body": "Try `ping 203.0.113.10` from astro. If it fails, remember: traffic needs a route there and a route back. Check every hop with `route print` and `tracert`.",
        "objectives": [
          {
            "id": "m4l6-earth-a",
            "label": "astro can reach Earth's server",
            "check": {
              "type": "ping",
              "from": "astro",
              "expect": "success",
              "toDevice": "earth-cloud"
            }
          },
          {
            "id": "m4l6-earth-v",
            "label": "volt can reach Earth's server",
            "check": {
              "type": "ping",
              "from": "volt",
              "expect": "success",
              "toDevice": "earth-cloud"
            }
          }
        ]
      },
      {
        "title": "4. Services: send the distress call",
        "body": "Now by name. Earth's relay is `earth.relay`. `nslookup earth.relay` on astro shows whether the ship's name server knows it. Teach it, then open `http://earth.relay/` from astro and read Earth's reply.",
        "objectives": [
          {
            "id": "m4l6-dns",
            "label": "astro resolves earth.relay to 203.0.113.10",
            "check": {
              "type": "dns",
              "from": "astro",
              "name": "earth.relay",
              "expect": "resolves",
              "addr": "203.0.113.10"
            }
          },
          {
            "id": "m4l6-call",
            "label": "astro receives Earth's answer",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://earth.relay/",
              "expect": "ok",
              "contains": "Distress call received"
            }
          }
        ]
      }
    ]
  }
}
