        "eth0"
      ]
    },
    {
      "id": "volt.eth0-relay.eth1",
      "a": [
        "volt",
        "eth0"
      ],
      "b": [
        "relay",
        "eth1"
      ]
    },
    {
      "id": "rivet.eth0-relay.eth2",
      "a": [
        "rivet",
        "eth0"
      ],
      "b": [
        "relay",
        "eth2"
      ]
    },
    {
      "id": "ship-server.eth0-relay.eth3",
      "a": [
