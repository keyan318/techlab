  "lab": {
    "id": "g3-l4",
    "title": "Lesson 3.4 — First Hop Redundancy",
    "blurb": "Two gateway routers, one virtual address, zero dark hangars.",
    "steps": [
      {
        "title": "Create the virtual gateway",
        "body": "The PCs' gateway 192.168.60.1 belongs to nobody yet: `ping 192.168.60.1` from pc1 fails. On both `dist-a` and `dist-b`: `interface g0/1`, then `standby 10 ip 192.168.60.1`. `show standby brief` shows one Active and one Standby.",
        "objectives": [
          {
            "id": "g3l4-gw",
            "label": "pc1 reaches its gateway 192.168.60.1",
            "check": {
              "type": "ping",
              "from": "pc1",
              "expect": "success",
              "toAddr": "192.168.60.1"
            }
          },
          {
            "id": "g3l4-srv",
            "label": "pc1 reaches the Grid server",
            "check": {
              "type": "ping",
              "from": "pc1",
              "expect": "success",
              "toDevice": "grid-srv"
            }
          },
          {
            "id": "g3l4-srv2",
            "label": "pc2 reaches the Grid server",
            "check": {
              "type": "ping",
              "from": "pc2",
              "expect": "success",
              "toDevice": "grid-srv"
            }
          }
        ]
      },
      {
        "title": "Make dist-a the boss",
        "body": "dist-a has the faster uplink, so it should be active whenever it is up. On `dist-a`, `interface g0/1`: `standby 10 priority 110` and `standby 10 preempt`. Preempt is what lets it take the role back after a reboot.",
        "objectives": [
          {
            "id": "g3l4-act",
            "label": "dist-a is the active router for group 10",
            "check": {
              "type": "fhrp-active",
              "device": "dist-a",
              "group": 10,
              "proto": "hsrp"
            }
          },
          {
            "id": "g3l4-pre",
            "label": "dist-a has preempt",
            "check": {
              "type": "iface-config",
              "device": "dist-a",
              "iface": "eth1",
              "is": {
                "fhrpPreempt": true
              }
            }
          }
        ]
      },
      {
        "title": "Survive a lost uplink",
        "body": "Volt: \"Pull the plug, on paper.\" If dist-a's hangar port dies, dist-b takes over by itself. But if dist-a loses its uplink to the core, dist-a is still Active, with nowhere to send traffic. On `dist-a` g0/1: `standby 10 track g0/0 20` (110 minus 20 is 90, below dist-b's 100). On `dist-b` g0/1: `standby 10 preempt`, so it takes over when dist-a drops below it. The grader cuts each link for a moment and follows the traffic.",
        "objectives": [
          {
            "id": "g3l4-trk",
            "label": "dist-a tracks its uplink Gi0/0",
            "check": {
              "type": "iface-config",
              "device": "dist-a",
              "iface": "eth1",
              "is": {
                "fhrpTrack": "eth0"
              }
            }
          },
          {
            "id": "g3l4-preb",
            "label": "dist-b has preempt",
            "check": {
              "type": "iface-config",
              "device": "dist-b",
              "iface": "eth1",
              "is": {
                "fhrpPreempt": true
              }
            }
          },
          {
            "id": "g3l4-s1",
            "label": "pc1 still reaches the Grid server if dist-a's hangar port fails",
            "check": {
              "type": "survives",
              "from": "pc1",
              "toDevice": "grid-srv",
              "cut": {
                "device": "dist-a",
                "iface": "eth1"
              }
            }
          },
          {
            "id": "g3l4-s2",
            "label": "pc2 still reaches the Grid server if dist-a loses its core link",
            "check": {
              "type": "survives",
              "from": "pc2",
              "toDevice": "grid-srv",
              "cut": {
                "device": "dist-a",
                "iface": "eth0"
              }
            }
          }
        ]
      }
    ]
  }
}
