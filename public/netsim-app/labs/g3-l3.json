  "lab": {
    "id": "g3-l3",
    "title": "Lesson 3.3 — Redundant Paths & Convergence",
    "blurb": "Close the ring, then prove the Grid survives a cut cable.",
    "steps": [
      {
        "title": "Close the ring",
        "body": "The Northwatch–Skyport cable is plugged in but both ends are shut, and Northwatch doesn't run OSPF on it. On `northwatch`: `interface g0/1`, `no shutdown`, then `router ospf 1`, `network 10.0.34.0 0.0.0.3 area 0`. On `skyport`: `interface g0/1`, `no shutdown` (its OSPF already covers 10.0.0.0/16).",
        "objectives": [
          {
            "id": "g3l3-up1",
            "label": "northwatch Gi0/1 is up",
            "check": {
              "type": "iface-config",
              "device": "northwatch",
              "iface": "eth1",
              "is": {
                "shutdown": false
              }
            }
          },
          {
            "id": "g3l3-up2",
            "label": "skyport Gi0/1 is up",
            "check": {
              "type": "iface-config",
              "device": "skyport",
              "iface": "eth1",
              "is": {
                "shutdown": false
              }
            }
          },
          {
            "id": "g3l3-nb",
            "label": "northwatch and skyport are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "northwatch",
              "neighbor": "skyport",
              "expect": "full"
            }
          },
          {
            "id": "g3l3-ecmp",
            "label": "landing has two equal paths to Skyport's LAN",
            "check": {
              "type": "route",
              "device": "landing",
              "dest": "192.168.50.0/24",
              "source": "ospf",
              "expect": "present",
              "paths": 2
            }
          }
        ]
      },
      {
        "title": "Prove it survives",
        "body": "Volt: \"Test it like Doom would.\" Look at `show ip route ospf` on landing: Skyport's network appears twice. Press Check objectives: the grader cuts one link at a time for a moment, follows the routing, and puts the link back. Try it yourself too: `shutdown` on landing's g0/1, `traceroute 192.168.50.10` from landing, then `no shutdown`.",
        "objectives": [
          {
            "id": "g3l3-s1",
            "label": "astro still reaches rivet if landing's link to the Citadel fails",
            "check": {
              "type": "survives",
              "from": "astro",
              "toDevice": "rivet",
              "cut": {
                "device": "landing",
                "iface": "eth1"
              }
            }
          },
          {
            "id": "g3l3-s2",
            "label": "astro still reaches rivet if landing's link to Northwatch fails",
            "check": {
              "type": "survives",
              "from": "astro",
              "toDevice": "rivet",
              "cut": {
                "device": "landing",
                "iface": "eth2"
              }
            }
          },
          {
            "id": "g3l3-s3",
            "label": "astro still reaches rivet if the Citadel–Skyport cable fails",
            "check": {
              "type": "survives",
              "from": "astro",
              "toDevice": "rivet",
              "cut": {
                "device": "citadel",
                "iface": "eth1"
              }
            }
          },
          {
            "id": "g3l3-p",
            "label": "astro reaches rivet now",
            "check": {
              "type": "ping",
              "from": "astro",
              "expect": "success",
              "toDevice": "rivet"
            }
          }
        ]
      }
    ]
  }
}
