  "lab": {
    "id": "g6-l2",
    "title": "Lesson 6.2 — DMZ Design",
    "blurb": "Three zones, one firewall, default deny.",
    "steps": [
      {
        "title": "Default deny",
        "body": "Double-click `shield` (it runs Windows Server). `netsh advfirewall show allprofiles`: on, but allowing everything. Make it stateful and default deny: `netsh advfirewall set allprofiles state on`, then `netsh advfirewall set allprofiles firewallpolicy blockinbound,allowoutbound`.",
        "objectives": [
          {
            "id": "g6l2-pol",
            "label": "shield blocks routed traffic by default",
            "check": {
              "type": "fw-policy",
              "device": "shield",
              "hook": "forward",
              "policy": "drop"
            }
          },
          {
            "id": "g6l2-doomdb",
            "label": "doom-scan can no longer reach the crew database (5432)",
            "check": {
              "type": "tcp",
              "from": "doom-scan",
              "toDevice": "crew-db",
              "port": 5432,
              "expect": "filtered"
            }
          }
        ]
      },
      {
        "title": "Let the crew out",
        "body": "Now the crew is blocked too. Allow anything that starts on the inside: `netsh advfirewall firewall add rule name=CrewOut dir=in action=allow remoteip=192.168.20.0/24`. The replies come back by themselves: that's the stateful part.",
        "objectives": [
          {
            "id": "g6l2-crewrule",
            "label": "shield has the CrewOut rule",
            "check": {
              "type": "fw-rule",
              "device": "shield",
              "name": "CrewOut"
            }
          },
          {
            "id": "g6l2-earth",
            "label": "astro opens Earth's page",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://203.0.113.10/",
              "expect": "ok",
              "contains": "Earth relay"
            }
          },
          {
            "id": "g6l2-dmz",
            "label": "astro opens the DMZ page",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://172.16.0.10/",
              "expect": "ok",
              "contains": "Grid public page"
            }
          }
        ]
      },
      {
        "title": "Publish the DMZ, nothing more",
        "body": "Open exactly one door from outside: `netsh advfirewall firewall add rule name=DMZWeb dir=in action=allow protocol=TCP localport=80 localip=172.16.0.10`. No rule lets the DMZ start connections to the inside, so a hacked web server stays in its box.",
        "objectives": [
          {
            "id": "g6l2-webrule",
            "label": "shield has the DMZWeb rule",
            "check": {
              "type": "fw-rule",
              "device": "shield",
              "name": "DMZWeb"
            }
          },
          {
            "id": "g6l2-pub",
            "label": "Earth opens the Grid's public page",
            "check": {
              "type": "http",
              "from": "earth-srv",
              "url": "http://172.16.0.10/",
              "expect": "ok",
              "contains": "Grid public page"
            }
          },
          {
            "id": "g6l2-dmzdb",
            "label": "dmz-web cannot reach the crew database",
            "check": {
              "type": "tcp",
              "from": "dmz-web",
              "toDevice": "crew-db",
              "port": 5432,
              "expect": "filtered"
            }
          },
          {
            "id": "g6l2-doomdb2",
            "label": "doom-scan still cannot reach the crew database",
            "check": {
              "type": "tcp",
              "from": "doom-scan",
              "toDevice": "crew-db",
              "port": 5432,
              "expect": "filtered"
            }
          }
        ]
      }
    ]
  }
