  "lab": {
    "id": "g2-l3",
    "title": "Lesson 2.3 — OSPF Configuration & Optimization",
    "blurb": "Steer traffic off the radio, hush the LANs, share the way to Earth.",
    "steps": [
      {
        "title": "Make the radio expensive",
        "body": "On `landing`, `show ip route ospf` shows Northwatch's network via 10.0.13.2: the radio. Price it out on both ends: `interface g0/2` on landing and `interface g0/0` on northwatch, then `ip ospf cost 50` on each. `show ip route ospf` now points through the Citadel (10.0.12.2).",
        "objectives": [
          {
            "id": "g2l3-c1",
            "label": "landing's radio port Gi0/2 costs 50",
            "check": {
              "type": "iface-config",
              "device": "landing",
              "iface": "eth2",
              "is": {
                "ospfCost": 50
              }
            }
          },
          {
            "id": "g2l3-c2",
            "label": "northwatch's radio port Gi0/0 costs 50",
            "check": {
              "type": "iface-config",
              "device": "northwatch",
              "iface": "eth0",
              "is": {
                "ospfCost": 50
              }
            }
          },
          {
            "id": "g2l3-path1",
            "label": "astro to volt goes through the Citadel",
            "check": {
              "type": "path",
              "from": "astro",
              "toDevice": "volt",
              "through": "citadel",
              "expect": "through"
            }
          },
          {
            "id": "g2l3-path2",
            "label": "volt to astro goes through the Citadel too",
            "check": {
              "type": "path",
              "from": "volt",
              "toDevice": "astro",
              "through": "citadel",
              "expect": "through"
            }
          }
        ]
      },
      {
        "title": "Hush the PC networks",
        "body": "In `router ospf 1`: `passive-interface g0/0` on landing and `passive-interface g0/2` on northwatch. The networks stay in OSPF; only the hellos stop.",
        "objectives": [
          {
            "id": "g2l3-pa1",
            "label": "landing Gi0/0 is passive",
            "check": {
              "type": "iface-config",
              "device": "landing",
              "iface": "eth0",
              "is": {
                "ospfPassive": true
              }
            }
          },
          {
            "id": "g2l3-pa2",
            "label": "northwatch Gi0/2 is passive",
            "check": {
              "type": "iface-config",
              "device": "northwatch",
              "iface": "eth2",
              "is": {
                "ospfPassive": true
              }
            }
          },
          {
            "id": "g2l3-n",
            "label": "landing and citadel are still neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "landing",
              "neighbor": "citadel",
              "expect": "full"
            }
          }
        ]
      },
      {
        "title": "Share the way to Earth",
        "body": "Only `citadel` has a default route (to Earth, 203.0.113.1). In its `router ospf 1`, type `default-information originate`. On `landing`, `show ip route` now has an `O*E2 0.0.0.0/0` line. Test from astro: `curl http://198.51.100.10/`.",
        "objectives": [
          {
            "id": "g2l3-def",
            "label": "landing learned a default route from OSPF",
            "check": {
              "type": "route",
              "device": "landing",
              "dest": "0.0.0.0/0",
              "source": "ospf",
              "expect": "present"
            }
          },
          {
            "id": "g2l3-earth",
            "label": "astro opens Earth's relay page",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://198.51.100.10/",
              "expect": "ok",
              "contains": "Earth relay"
            }
          },
          {
            "id": "g2l3-earth2",
            "label": "volt reaches Earth's relay too",
            "check": {
              "type": "ping",
              "from": "volt",
              "expect": "success",
              "toDevice": "earth-relay"
            }
          }
        ]
      }
    ]
  }
}
