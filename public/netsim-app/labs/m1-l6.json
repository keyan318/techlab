{
  "app": "netsim",
  "version": 1,
  "devices": [
    {
      "id": "astro",
      "kind": "host",
      "name": "astro",
      "x": 70,
      "y": 200,
      "forwarding": false,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "192.168.1.10/24",
          "up": true
        }
      ],
      "routes": []
    },
    {
      "id": "gate",
      "kind": "router",
      "name": "gate",
      "x": 340,
      "y": 200,
      "forwarding": true,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "192.168.1.1/24",
          "up": true
        },
        {
          "name": "eth1",
          "ip": "203.0.113.1/24",
          "up": true
        }
      ],
      "routes": []
    },
    {
      "id": "earth-cloud",
      "kind": "server",
      "name": "earth-cloud",
      "x": 620,
      "y": 60,
      "forwarding": false,
      "ifaces": [
        {
          "name": "eth0",
          "ip": "203.0.113.10/24",
          "up": true
        }
      ],
      "routes": [],
      "httpServer": {
        "enabled": true,
        "port": 80,
        "body": "Welcome to the Earth Cloud. Message received, Captain."
      }
    }
  ],
  "links": [
    {
      "id": "astro.eth0-gate.eth0",
      "a": [
        "astro",
        "eth0"
      ],
      "b": [
        "gate",
        "eth0"
      ]
    },
    {
      "id": "gate.eth1-earth-cloud.eth0",
      "a": [
        "gate",
        "eth1"
      ],
      "b": [
        "earth-cloud",
        "eth0"
      ]
    }
  ],
  "lab": {
    "id": "m1-l6",
    "title": "Lesson 1.6 \u2014 Cloud Relay",
    "blurb": "Reach the Earth Cloud across the wide-area link.",
    "steps": [
      {
        "title": "Signal the Earth Cloud",
        "body": "The Earth Cloud is a server far away, on a different network, reached through the router `gate`. From astro run `curl http://203.0.113.10/`. It will not work yet, because neither end knows how to leave its own network. Give astro a default route via `192.168.1.1`, and give earth-cloud one via `203.0.113.1` so its reply can come back.",
        "objectives": [
          {
            "id": "m1l6-def-a",
            "label": "astro's default route goes via 192.168.1.1",
            "check": {
              "type": "default-route",
              "device": "astro",
              "via": "192.168.1.1"
            }
          },
          {
            "id": "m1l6-def-c",
            "label": "earth-cloud's default route goes via 203.0.113.1",
            "check": {
              "type": "default-route",
              "device": "earth-cloud",
              "via": "203.0.113.1"
            }
          },
          {
            "id": "m1l6-http",
            "label": "astro can fetch the Earth Cloud page",
            "check": {
              "type": "http",
              "from": "astro",
              "url": "http://203.0.113.10/",
              "expect": "ok",
              "contains": "Earth Cloud"
            }
          }
        ]
      }
    ]
  }
}
