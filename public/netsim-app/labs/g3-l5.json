  "lab": {
    "id": "g3-l5",
    "title": "Lesson 3.5 — Midterm Mission: The Northwatch Storm",
    "blurb": "A storm, an old backup, and at least three faults. Bottom up.",
    "steps": [
      {
        "title": "Layer 2 first",
        "body": "On `nw-sw`, run `show vlan brief`. Northwatch's subnet is VLAN 30: both router ports and the camera are there, but one PC port is not. Fix it with `switchport access vlan 30` on that port.",
        "objectives": [
          {
            "id": "g3l5-v",
            "label": "volt's port Gi0/1 is in VLAN 30",
            "check": {
              "type": "iface-config",
              "device": "nw-sw",
              "iface": "eth0",
              "is": {
                "accessVlan": 30
              }
            }
          },
          {
            "id": "g3l5-gw",
            "label": "volt reaches nw-a (192.168.30.2)",
            "check": {
              "type": "ping",
              "from": "volt",
              "expect": "success",
              "toAddr": "192.168.30.2"
            }
          }
        ]
      },
      {
        "title": "Routing next",
        "body": "On `citadel`, `show ip ospf neighbor` should list both Northwatch routers. One is missing. Compare `show ip ospf interface brief` on `citadel` and on the missing router, then fix the area on the Northwatch side: Northwatch's uplinks belong to area 1.",
        "objectives": [
          {
            "id": "g3l5-n1",
            "label": "citadel and nw-a are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "citadel",
              "neighbor": "nw-a",
              "expect": "full"
            }
          },
          {
            "id": "g3l5-n2",
            "label": "citadel and nw-b are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "citadel",
              "neighbor": "nw-b",
              "expect": "full"
            }
          },
          {
            "id": "g3l5-r",
            "label": "citadel has two paths to Northwatch's LAN",
            "check": {
              "type": "route",
              "device": "citadel",
              "dest": "192.168.30.0/24",
              "source": "ospf",
              "expect": "present",
              "paths": 2
            }
          }
        ]
      },
      {
        "title": "Then the gateway",
        "body": "The PCs use 192.168.30.1. Run `show standby brief` on both routers: they don't agree on the virtual IP, so each thinks it is alone. Fix the wrong one with `standby 30 ip 192.168.30.1` on its g0/1. Then prove it: the grader cuts each router's LAN port in turn.",
        "objectives": [
          {
            "id": "g3l5-act",
            "label": "nw-a is the active router for group 30",
            "check": {
              "type": "fhrp-active",
              "device": "nw-a",
              "group": 30,
              "proto": "hsrp"
            }
          },
          {
            "id": "g3l5-http",
            "label": "volt opens the Citadel server",
            "check": {
              "type": "http",
              "from": "volt",
              "url": "http://192.168.20.10/",
              "expect": "ok",
              "contains": "Northwatch is back"
            }
          },
          {
            "id": "g3l5-s1",
            "label": "volt still reaches the Citadel if nw-a's LAN port fails",
            "check": {
              "type": "survives",
              "from": "volt",
              "toDevice": "citadel-srv",
              "cut": {
                "device": "nw-a",
                "iface": "eth1"
              }
            }
          },
          {
            "id": "g3l5-s2",
            "label": "volt still reaches the Citadel if nw-b's LAN port fails",
            "check": {
              "type": "survives",
              "from": "volt",
              "toDevice": "citadel-srv",
              "cut": {
                "device": "nw-b",
                "iface": "eth1"
              }
            }
          }
        ]
      }
    ]
  }
}
