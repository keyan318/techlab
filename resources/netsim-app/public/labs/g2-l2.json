  "lab": {
    "id": "g2-l2",
    "title": "Lesson 2.2 — OSPF Areas & LSA Types",
    "blurb": "Two areas, one border router, one argument to settle, one blank router to join.",
    "steps": [
      {
        "title": "Settle the area argument",
        "body": "Run `show ip ospf neighbor` on `citadel`: no Northwatch. Compare `show ip ospf interface brief` on both routers: the 10.0.23.0/30 link is area 1 on the Citadel but area 0 on Northwatch. Area 1 is right. On `northwatch`: `router ospf 1`, `no network 10.0.23.0 0.0.0.3 area 0`, then `network 10.0.23.0 0.0.0.3 area 1`.",
        "objectives": [
          {
            "id": "g2l2-n1",
            "label": "citadel and northwatch are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "citadel",
              "neighbor": "northwatch",
              "expect": "full"
            }
          },
          {
            "id": "g2l2-r1",
            "label": "skyport learned 192.168.30.0/24 (inter-area)",
            "check": {
              "type": "route",
              "device": "skyport",
              "dest": "192.168.30.0/24",
              "source": "ospf",
              "expect": "present"
            }
          },
          {
            "id": "g2l2-p1",
            "label": "rivet reaches volt",
            "check": {
              "type": "ping",
              "from": "rivet",
              "expect": "success",
              "toDevice": "volt"
            }
          }
        ]
      },
      {
        "title": "Join Deep Well to area 1",
        "body": "Deep Well's router is addressed but has no OSPF. On `deepwell`: `router ospf 1`, `network 10.0.34.0 0.0.0.3 area 1`, `network 192.168.40.0 0.0.0.255 area 1`. Then on `skyport`, `show ip route ospf` shows Deep Well's network as `O IA`, and `show ip ospf database` shows the Citadel's Type 3 summaries.",
        "objectives": [
          {
            "id": "g2l2-n2",
            "label": "northwatch and deepwell are OSPF neighbors",
            "check": {
              "type": "ospf-neighbor",
              "device": "northwatch",
              "neighbor": "deepwell",
              "expect": "full"
            }
          },
          {
            "id": "g2l2-r2",
            "label": "skyport learned 192.168.40.0/24 (inter-area)",
            "check": {
              "type": "route",
              "device": "skyport",
              "dest": "192.168.40.0/24",
              "source": "ospf",
              "expect": "present"
            }
          },
          {
            "id": "g2l2-p2",
            "label": "rivet reaches cadet at Deep Well",
            "check": {
              "type": "ping",
              "from": "rivet",
              "expect": "success",
              "toDevice": "cadet"
            }
          }
        ]
      }
    ]
  }
