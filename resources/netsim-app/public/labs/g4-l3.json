  "lab": {
    "id": "g4-l3",
    "title": "Lesson 4.3 — Spanning Tree: RSTP & MST",
    "blurb": "Three switches in a triangle and the wrong root bridge.",
    "steps": [
      {
        "title": "Go rapid",
        "body": "On each of the three switches: `enable`, `conf t`, `spanning-tree mode rapid-pvst`. `show spanning-tree` now says \"protocol rstp\".",
        "objectives": [
          {
            "id": "g4l3-m1",
            "label": "core-sw runs Rapid PVST+",
            "check": {
              "type": "stp-mode",
              "device": "core-sw",
              "mode": "rapid-pvst"
            }
          },
          {
            "id": "g4l3-m2",
            "label": "dist-sw runs Rapid PVST+",
            "check": {
              "type": "stp-mode",
              "device": "dist-sw",
              "mode": "rapid-pvst"
            }
          },
          {
            "id": "g4l3-m3",
            "label": "old-sw runs Rapid PVST+",
            "check": {
              "type": "stp-mode",
              "device": "old-sw",
              "mode": "rapid-pvst"
            }
          }
        ]
      },
      {
        "title": "Choose the root",
        "body": "Run `show spanning-tree vlan 10` on old-sw: \"This bridge is the root\". Fix it. On `core-sw`: `spanning-tree vlan 1,10 root primary`. On `dist-sw`: `spanning-tree vlan 1,10 root secondary`, the backup root.",
        "objectives": [
          {
            "id": "g4l3-r1",
            "label": "core-sw is root for VLAN 1",
            "check": {
              "type": "stp-root",
              "vlan": 1,
              "device": "core-sw"
            }
          },
          {
            "id": "g4l3-r10",
            "label": "core-sw is root for VLAN 10",
            "check": {
              "type": "stp-root",
              "vlan": 10,
              "device": "core-sw"
            }
          },
          {
            "id": "g4l3-b10",
            "label": "In VLAN 10, old-sw blocks its link to dist-sw (Gi0/2)",
            "check": {
              "type": "stp-port",
              "device": "old-sw",
              "iface": "eth1",
              "vlan": 10,
              "state": "blocking"
            }
          },
          {
            "id": "g4l3-p10",
            "label": "pc10 reaches srv10",
            "check": {
              "type": "ping",
              "from": "pc10",
              "expect": "success",
              "toDevice": "srv10"
            }
          }
        ]
      },
      {
        "title": "Share the load",
        "body": "Everything now flows through core-sw, and old-sw's link to dist-sw sits idle. Give VLAN 20 its own root: on `dist-sw`, `spanning-tree vlan 20 root primary`; on `core-sw`, `spanning-tree vlan 20 root secondary`. Compare `show spanning-tree vlan 10` and `vlan 20` on old-sw: each VLAN blocks a different uplink.",
        "objectives": [
          {
            "id": "g4l3-r20",
            "label": "dist-sw is root for VLAN 20",
            "check": {
              "type": "stp-root",
              "vlan": 20,
              "device": "dist-sw"
            }
          },
          {
            "id": "g4l3-b20",
            "label": "In VLAN 20, old-sw blocks its link to core-sw (Gi0/1)",
            "check": {
              "type": "stp-port",
              "device": "old-sw",
              "iface": "eth0",
              "vlan": 20,
              "state": "blocking"
            }
          },
          {
            "id": "g4l3-p20",
            "label": "pc20 reaches srv20",
            "check": {
              "type": "ping",
              "from": "pc20",
              "expect": "success",
              "toDevice": "srv20"
            }
          }
        ]
      }
    ]
  }
