APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (course join codes). Free Gmail SMTP: turn on 2-Step Verification for the
# TechLab Gmail account, create an App Password at myaccount.google.com/apppasswords,
# and paste its 16 letters into MAIL_PASSWORD in your local .env (never here).
# MAIL_FROM_ADDRESS must be that same Gmail address. MAIL_MAILER=log writes emails
# to storage/logs/laravel.log instead of sending them.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TechLab"

# NVIDIA NIM — TechLab AI tutor (Astro)
# Server-side only. Never expose this key to the browser.
# Paste your key from the NVIDIA NIM console into your local .env (leave empty here).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# REQUIRED: set the NVIDIA model slug Astro should use, e.g.
#   nvidia/nemotron-3-super-120b-a12b
#   nvidia/nemotron-3-ultra-550b-a55b
# There is NO default — chat will not respond until this is set.
NVIDIA_NIM_MODEL=

# NVIDIA image model for the Infographic Studio (illustrator) — OPTIONAL.
# The infographic feature works WITHOUT a separate image model: when these are
# empty it falls back to an offline, dependency-free SVG space-art generator, so
# the deck always renders. Set them only if you have a provisioned NVIDIA image
# model. It reuses the same NVIDIA_NIM_API_KEY (no second key required).
# Example:
#   NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
#   NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
# INFOGRAPHIC_IMAGE_PROVIDER switches between 'local_art' (default) and 'nvidia'.
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
INFOGRAPHIC_IMAGE_PROVIDER=local_art

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reuse the DB connection across requests (big win when the database is remote)
DB_PERSISTENT=false

# Web research sources (Tavily) — OPTIONAL. Powers cited web sources in the Sources
# sidebar for extensive-research questions only. Empty = web research off.
TAVILY_API_KEY=
